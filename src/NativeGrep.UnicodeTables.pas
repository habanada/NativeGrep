function FindFold(CodePoint: Cardinal): Integer;
var L, R, M: Integer;
begin
  L := 0; R := High(FoldEntries);
  while L <= R do
  begin
    M := L + (R - L) div 2;
    if FoldEntries[M].CodePoint = CodePoint then Exit(M);
    if FoldEntries[M].CodePoint < CodePoint then L := M + 1 else R := M - 1;
  end;
  Result := -1;
end;

function FindDecomposition(CodePoint: Cardinal): Integer;
var L, R, M: Integer;
begin
  L := 0; R := High(DecompEntries);
  while L <= R do
  begin
    M := L + (R - L) div 2;
    if DecompEntries[M].CodePoint = CodePoint then Exit(M);
    if DecompEntries[M].CodePoint < CodePoint then L := M + 1 else R := M - 1;
  end;
  Result := -1;
end;

function GrepUnicodeCombiningClass(CodePoint: Cardinal): Byte;
var L, R, M: Integer;
begin
  L := 0; R := High(ClassEntries);
  while L <= R do
  begin
    M := L + (R - L) div 2;
    if ClassEntries[M].CodePoint = CodePoint then Exit(ClassEntries[M].ClassValue);
    if ClassEntries[M].CodePoint < CodePoint then L := M + 1 else R := M - 1;
  end;
  Result := 0;
end;

procedure Append(var Values: TArray<Cardinal>; var Count: Integer; Value: Cardinal);
begin
  if Count = Length(Values) then SetLength(Values, Count * 2 + 8);
  Values[Count] := Value;
  Inc(Count);
end;

procedure DecomposeOne(CodePoint: Cardinal; var Values: TArray<Cardinal>; var Count: Integer);
var I, J, A, B, C: Integer;
begin
  if (CodePoint >= $AC00) and (CodePoint <= $D7A3) then
  begin
    I := Integer(CodePoint) - $AC00;
    A := I div 588;
    B := (I mod 588) div 28;
    C := I mod 28;
    Append(Values, Count, $1100 + A);
    Append(Values, Count, $1161 + B);
    if C <> 0 then Append(Values, Count, $11A7 + C);
    Exit;
  end;
  J := FindDecomposition(CodePoint);
  if J < 0 then Append(Values, Count, CodePoint)
  else
    for I := 0 to DecompEntries[J].DataLength - 1 do
      Append(Values, Count, DecompData[DecompEntries[J].DataOffset + I]);
end;

function GrepUnicodeExpand(CodePoint: Cardinal; Fold, Decompose: Boolean): TArray<Cardinal>;
var First, Second: TArray<Cardinal>; I, J, N, F, Count: Integer;
begin
  SetLength(First, 0); N := 0;
  if Decompose then DecomposeOne(CodePoint, First, N) else Append(First, N, CodePoint);
  SetLength(Second, 0); Count := 0;
  for I := 0 to N - 1 do
  begin
    F := -1;
    if Fold then F := FindFold(First[I]);
    if F >= 0 then
      for J := 0 to FoldEntries[F].DataLength - 1 do
      begin
        if Decompose then DecomposeOne(FoldData[FoldEntries[F].DataOffset + J], Second, Count)
        else Append(Second, Count, FoldData[FoldEntries[F].DataOffset + J]);
      end
    else if Decompose then DecomposeOne(First[I], Second, Count)
    else Append(Second, Count, First[I]);
  end;
  SetLength(Second, Count);
  Result := Second;
end;

